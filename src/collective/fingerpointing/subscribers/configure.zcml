<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zcml">

  <!-- PluggableAuthService -->
  <subscriber
      for="Products.PluggableAuthService.interfaces.events.IUserLoggedInEvent"
      handler=".pas_logger"
      />

  <subscriber
      for="Products.PluggableAuthService.interfaces.events.IUserLoggedOutEvent"
      handler=".pas_logger"
      />

  <subscriber
      for="Products.PluggableAuthService.interfaces.events.IPrincipalCreatedEvent"
      handler=".pas_logger"
      />

  <subscriber
      for="Products.PluggableAuthService.interfaces.events.IPrincipalDeletedEvent"
      handler=".pas_logger"
      />

  <subscriber
      for="Products.PluggableAuthService.interfaces.events.IGroupDeletedEvent"
      handler=".pas_logger"
      />

  <subscriber
      for="Products.PluggableAuthService.interfaces.events.IGroupCreatedEvent"
      handler=".pas_logger"
      />

  <subscriber
      for="Products.PluggableAuthService.interfaces.events.IPrincipalAddedToGroupEvent"
      handler=".pas_logger"
      />

  <subscriber
      for="Products.PluggableAuthService.interfaces.events.IPrincipalRemovedFromGroupEvent"
      handler=".pas_logger"
      />

  <subscriber
      for="Products.PluggableAuthService.interfaces.events.ICredentialsUpdatedEvent"
      handler=".pas_logger"
      />

  <subscriber
      for="Products.PluggableAuthService.interfaces.events.IPropertiesUpdatedEvent"
      handler=".pas_logger"
      />

  <!-- Failed logins: PAS does not fire an event for these -->
  <subscriber
      for="ZPublisher.interfaces.IPubAfterTraversal"
      handler=".failed_login_logger"
      />

  <subscriber
      for="ZPublisher.interfaces.IPubBeforeCommit"
      handler=".failed_api_login_logger"
      />

  <!-- Role changes: fired by collective.fingerpointing.patches -->
  <subscriber
      for="collective.fingerpointing.interfaces.IPrincipalRolesModifiedEvent"
      handler=".roles_logger"
      />

  <subscriber
      for="collective.fingerpointing.interfaces.ILocalRolesModifiedEvent"
      handler=".roles_logger"
      />

  <subscriber
      for="collective.fingerpointing.interfaces.ILocalRolesInheritanceModifiedEvent"
      handler=".roles_logger"
      />

  <!-- Dexterity -->
  <subscriber
      zcml:condition="installed plone.app.dexterity"
      for="plone.dexterity.interfaces.IDexterityContent
           zope.lifecycleevent.IObjectAddedEvent"
      handler=".lifecycle_logger"
      />

  <subscriber
      zcml:condition="installed plone.app.dexterity"
      for="plone.dexterity.interfaces.IDexterityContent
           zope.lifecycleevent.IObjectModifiedEvent"
      handler=".lifecycle_logger"
      />

  <subscriber
      zcml:condition="installed plone.app.dexterity"
      for="plone.dexterity.interfaces.IDexterityContent
           zope.lifecycleevent.IObjectRemovedEvent"
      handler=".lifecycle_logger"
      />

  <!-- plone.app.registry -->
  <subscriber
      for="plone.registry.interfaces.IRecordModifiedEvent"
      handler=".registry_logger"
      />

  <!-- plone.app.iterate -->
  <subscriber
      zcml:condition="installed plone.app.iterate"
      for="plone.app.iterate.interfaces.ICheckoutEvent"
      handler=".iterate_logger"
      />

  <subscriber
      zcml:condition="installed plone.app.iterate"
      for="plone.app.iterate.interfaces.ICheckinEvent"
      handler=".iterate_logger"
      />

  <subscriber
      zcml:condition="installed plone.app.iterate"
      for="plone.app.iterate.interfaces.ICancelCheckoutEvent"
      handler=".iterate_logger"
      />

  <!-- Workflow -->
  <subscriber
      for="Products.CMFCore.interfaces.IActionSucceededEvent"
      handler=".workflow_logger"
      />

  <!-- Generic Setup -->
  <subscriber
      for="Products.GenericSetup.interfaces.IProfileImportedEvent"
      handler=".profile_imports_logger"
      />

</configure>
